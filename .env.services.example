# ============================================================================
# Microservices environment — copy into your existing root `.env`
# ============================================================================
# These values extend (not replace) the legacy backend's .env. Every service
# reads from the same file.
# ----------------------------------------------------------------------------

# --- Gateway & legacy --------------------------------------------------------
GATEWAY_PORT=8000
LEGACY_BACKEND_HOST=localhost
LEGACY_BACKEND_PORT=8100

# --- Individual services -----------------------------------------------------
ANALYSIS_SERVICE_HOST=localhost
ANALYSIS_SERVICE_PORT=8001

KB_SERVICE_HOST=localhost
KB_SERVICE_PORT=8002

REVIEWS_SERVICE_HOST=localhost
REVIEWS_SERVICE_PORT=8003

ORG_SERVICE_HOST=localhost
ORG_SERVICE_PORT=8004

CONFIG_SERVICE_HOST=localhost
CONFIG_SERVICE_PORT=8005

NOTIFICATIONS_SERVICE_HOST=localhost
NOTIFICATIONS_SERVICE_PORT=8006

# --- Gateway tuning ----------------------------------------------------------
UPSTREAM_TIMEOUT_SECONDS=60

# --- Shared (already in your .env — listed for reference) --------------------
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/app
# REDIS_URL=redis://localhost:6379/0
# CLERK_AUTH_ENABLED=true
# CLERK_ISSUER_URL=...
# CLERK_JWKS_URL=...
# CLERK_SECRET_KEY=...
