# ============================================================================
# AI CODE REVIEW PLATFORM - MICROSERVICES CONFIGURATION
# ============================================================================

# --- Service Ports ---
PORT_API_GATEWAY=3000
AUTH_SERVICE_PORT=4001
ANALYSIS_SERVICE_PORT=4002
PROJECT_SERVICE_PORT=4003
REVIEW_SERVICE_PORT=4004
INTEGRATION_SERVICE_PORT=4005
AI_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
SECURITY_SERVICE_PORT=4008

# --- Service URLs (for inter-service communication) ---
API_GATEWAY_URL=http://api-gateway:3000
AUTH_SERVICE_URL=http://auth-service:4001
ANALYSIS_SERVICE_URL=http://analysis-service:4002
PROJECT_SERVICE_URL=http://project-service:4003
REVIEW_SERVICE_URL=http://review-service:4004
INTEGRATION_SERVICE_URL=http://integration-service:4005
AI_SERVICE_URL=http://ai-service:4006
NOTIFICATION_SERVICE_URL=http://notification-service:4007
SECURITY_SERVICE_URL=http://security-service:4008

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:simplepass@postgres:5432/ai_code_review_platform

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Clerk Authentication ---
CLERK_AUTH_ENABLED=true
CLERK_ISSUER_URL=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_SECRET_KEY=sk_test_your_secret_key

# --- GitHub Integration ---
GITHUB_APP_ID=your_app_id
GITHUB_APP_INSTALLATION_ID=your_installation_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_APP_PRIVATE_KEY_PEM="your_private_key"

# --- Jira Integration ---
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_API_TOKEN=

# --- AI/LLM Configuration ---
LLM_ENABLED=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-coder
OPENAI_API_KEY=

# --- Vector Store (Qdrant) ---
QDRANT_ENABLED=true
QDRANT_URL=http://qdrant:6333

# --- Object Storage (MinIO) ---
OBJECT_STORAGE_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=ai-review-artifacts

# --- Notifications ---
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
EMAIL_ENABLED=false
SENDGRID_API_KEY=

# --- Security ---
SECRET_SCAN_ENABLED=true
SECRETS_ENCRYPTION_KEY=

# --- Logging ---
LOG_LEVEL=INFO
