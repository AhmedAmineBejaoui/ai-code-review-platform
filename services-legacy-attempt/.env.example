# AI Code Review Platform - Microservices Configuration
# Copy this file to .env and configure for your environment

# ===== API GATEWAY CONFIGURATION =====
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# ===== SERVICE URLS (Internal Docker Network) =====
AUTH_SERVICE_URL=http://auth-service:8001
ANALYSIS_SERVICE_URL=http://analysis-service:8002
REVIEW_SERVICE_URL=http://review-service:8003
RAG_SERVICE_URL=http://rag-service:8004
NOTIFICATION_SERVICE_URL=http://notification-service:8005
WORKER_SERVICE_URL=http://worker-service:8006

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_code_review
POSTGRES_DB=ai_code_review
POSTGRES_USER=postgres  
POSTGRES_PASSWORD=postgres

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===== CLERK AUTHENTICATION =====
CLERK_AUTH_ENABLED=true
CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ===== QDRANT VECTOR STORE =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_ENABLED=true

# ===== LLM SERVICES =====
LLM_ENABLED=true
OPENAI_API_KEY=sk-your-openai-key
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== SECURITY =====
SECRETS_ENCRYPTION_KEY=your-fernet-key-here
WEBHOOK_SECRET=your-webhook-secret

# ===== DASHBOARD CONFIGURATION =====
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ===== NOTIFICATIONS =====
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=