# ==========================================
# PRODUCTION VPS - Dashboard Environment
# ==========================================
# For VPS deployment at 135.125.100.150
# ==========================================

# ==========================================
# Clerk Authentication
# ==========================================
# IMPORTANT: Use PRODUCTION keys, not test/dev keys
# Get production keys from: https://dashboard.clerk.com → API Keys → Production

# Option 1: Disable Clerk for now (simplest)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Option 2: Use production keys (recommended)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
# CLERK_SECRET_KEY=sk_live_xxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ==========================================
# Backend Connection
# ==========================================
# Server-side (Next.js container → FastAPI container)
BACKEND_API_URL=http://backend:8000

# Client-side (browser → VPS public IP)
NEXT_PUBLIC_BACKEND_URL=http://135.125.100.150:8000

# Dashboard public URL
NEXT_PUBLIC_API_URL=http://135.125.100.150:3001
NEXT_PUBLIC_APP_URL=http://135.125.100.150:3001

# ==========================================
# Real-time Collaboration (Y.js WebSocket)
# ==========================================
NEXT_PUBLIC_Y_WEBSOCKET_URL=ws://135.125.100.150:1234

# ==========================================
# Backend Fetch Timeouts
# ==========================================
DASHBOARD_BACKEND_FETCH_TIMEOUT_MS=15000
DASHBOARD_BACKEND_WRITE_TIMEOUT_MS=30000

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=production
