ENV=production

# Public DNS records pointing to the VPS
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
YJS_DOMAIN=yjs.example.com

# Core infrastructure
POSTGRES_DB=ai_code_review_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong
MINIO_BUCKET=ai-review-artifacts

# App secrets
GITHUB_WEBHOOK_SECRET=change-me
SECRETS_ENCRYPTION_KEY=generate-with-make-generate-fernet-key

# Clerk / auth
CLERK_AUTH_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_ORGANIZATIONS_ENFORCED=false
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_JS_URL=
NEXT_PUBLIC_CLERK_JS_VERSION=

# GitHub integration
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_API_BASE_URL=https://api.github.com
GH_TOKEN=
GITHUB_OAUTH_TOKEN=
DASHBOARD_ALLOW_GLOBAL_GITHUB_TOKEN_FALLBACK=false
ALLOWED_GITHUB_ORGS=
ALLOWED_GITHUB_TEAMS=
DASHBOARD_GITHUB_REQUIRE_ORG_CONTEXT=false
DASHBOARD_GITHUB_ENFORCE_OWNER_MATCH=false
DASHBOARD_GITHUB_TEAM_OWNER_MAP=

# Dashboard admin / timeout tuning
ADMIN_EMAILS=
DASHBOARD_ADMIN_EMAILS=
DASHBOARD_BACKEND_FETCH_TIMEOUT_MS=15000
DASHBOARD_BACKEND_SYNC_TIMEOUT_MS=15000
DASHBOARD_BACKEND_WRITE_TIMEOUT_MS=30000

# Backend feature flags
RBAC_ENFORCEMENT_ENABLED=false
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_GIT_TOKEN=
STATIC_ANALYSIS_TIMEOUT_SECONDS=60
STATIC_ANALYSIS_MAX_FILES=200
STATIC_ANALYSIS_MAX_FINDINGS=200
STATIC_ANALYSIS_FILTER_CHANGED_LINES=true
REVIEW_INTELLIGENCE_ENABLED=true
REVIEW_INTELLIGENCE_REQUIRE_QDRANT=true
QDRANT_API_KEY=
QDRANT_COLLECTION=code_review_rules
QDRANT_REPO_CONTEXT_COLLECTION=repo_context

# LLM configuration
LLM_ENABLED=false
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=400

# Notifications
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=
SLACK_BOT_TOKEN=
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
TEAMS_DEFAULT_CHANNEL=
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
