# Domain exposed by Caddy + DuckDNS
BACKEND_DOMAIN=your-subdomain.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# Core backend services
DATABASE_URL=postgresql+psycopg://postgres:replace-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
REDIS_URL=rediss://:replace-password@replace-id.upstash.io:6379/0
CELERY_BROKER_URL=rediss://:replace-password@replace-id.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://:replace-password@replace-id.upstash.io:6379/1
ANALYSIS_QUEUE_NAME=analyses
CELERY_WORKER_CONCURRENCY=2

# Security and auth
SECRETS_ENCRYPTION_KEY=replace-with-generated-fernet-key
GITHUB_WEBHOOK_SECRET=replace-with-random-hex-secret
CLERK_AUTH_ENABLED=true
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_ORGANIZATIONS_ENFORCED=false

# Optional hard admin override (comma-separated emails)
ADMIN_EMAILS=

# Optional integrations
RBAC_ENFORCEMENT_ENABLED=true
QDRANT_ENABLED=false
OBJECT_STORAGE_ENABLED=false
LLM_ENABLED=false
